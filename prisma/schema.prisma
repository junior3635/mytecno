generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
enum UserRole {
  ADMIN
  EDITOR
  AUTHOR
  VIEWER
  WRITER
}


model User {
  role     UserRole @default(ADMIN)
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0)
  articles  Article[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Article {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  content      String   // HTML
  category     String       @default("Technology")
  categorySlug String?
  categoryRef  Category?    @relation(fields: [categorySlug], references: [slug])
  seoTitle     String?
  seoDesc      String?
  featuredImage String? // public /uploads path of the featured image
  imageMeta    String? // JSON array of StoredImageMeta entries (in-article + hero) for the image pipeline
  isPublished  Boolean  @default(false)
  publishAt    DateTime?
  publishedAt  DateTime?
  views        Int      @default(0)
  recipePrepMin      Int?
  recipeCookMin      Int?
  recipeServings     Int?
  recipeDifficulty   String?
  recipeCalories     Int?
  recipeIngredients  String? // JSON array of strings
  recipeInstructions String? // JSON array of strings
  comments     Comment[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Comment {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  body      String
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([articleId])
}

model Subscriber {
  id        String    @id @default(cuid())
  email     String    @unique
  token     String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model PageView {
  id          String @id @default(cuid())
  date        String // YYYY-MM-DD (server local time)
  articleSlug String
  views       Int    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, articleSlug])
  @@index([date])
}

model SiteSettings {
  id               String   @id @default("global")
  siteName         String   @default("MyTechNews")
  siteUrl          String?
  adsenseClientId  String?
  adsenseAdSlot    String?
  adsenseAutoAds   Boolean  @default(true)
  adsenseManualUnits Boolean @default(false)
  adsenseOnHome    Boolean  @default(true)
  adsenseOnArticles Boolean @default(true)
  socialX          String?
  socialFacebook   String?
  socialInstagram  String?
  socialYoutube    String?
  socialTiktok     String?
  socialLinkedin   String?
  socialShowFooter Boolean  @default(true)
  amazonTag        String?
  geminiApiKey     String?
  anthropicApiKey  String?
  openaiApiKey     String?
  aiProvider       String   @default("gemini")
  aiModel          String   @default("gemini-3.6-flash")
  autoPublish      Boolean  @default(false)
  imageProvider    String   @default("auto")
  imageModel       String?
  imageStyle       String   @default("editorial")
  imageFallback    String   @default("placeholder") // placeholder | stock
  updatedAt        DateTime @updatedAt
}

model Log {
  id        String   @id @default(cuid())
  action    String
  message   String
  success   Boolean
  createdAt DateTime @default(now())
}

model GenerationMetric {
  id         String   @id @default(cuid())
  mode       String
  source     String?
  latencyMs  Int      @default(0)
  tokenCount Int      @default(0)
  success    Boolean  @default(true)
  createdAt  DateTime @default(now())
}
